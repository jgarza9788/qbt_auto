{
  "Rules": [
    {
      "Name": "Tag unwatched media (90+ days)",
      "Description": "Tags torrents whose linked media has no watch history in the last 90 days. Uses tautulli.* (any Tautulli instance) -- change the source to jellystat or jellyglance if that's what you run.",
      "Enabled": true,
      "Priority": 10,
      "StopOnMatch": false,
      "DryRun": true,
      "CronExpression": "0 4 * * *",
      "TimeZoneId": "UTC",
      "UseAdvancedSql": false,
      "ConditionTreeJson": "{\"kind\":\"group\",\"Operator\":\"And\",\"Children\":[{\"kind\":\"exists\",\"Source\":\"tautulli.*\",\"Negate\":true,\"Condition\":{\"kind\":\"comparison\",\"Field\":\"tautulli.*.days_since_watched\",\"Operator\":\"Lte\",\"Value\":90}}]}",
      "ActionsJson": "[{\"type\":\"add_tags\",\"Tags\":[\"stale\"]}]",
      "TargetInstanceIdsJson": "[]"
    },
    {
      "Name": "Remove stale tag once rewatched",
      "Description": "Removes the 'stale' tag from anything watched again in the last 90 days.",
      "Enabled": true,
      "Priority": 5,
      "StopOnMatch": false,
      "DryRun": true,
      "CronExpression": "0 4 * * *",
      "TimeZoneId": "UTC",
      "UseAdvancedSql": false,
      "ConditionTreeJson": "{\"kind\":\"group\",\"Operator\":\"And\",\"Children\":[{\"kind\":\"comparison\",\"Field\":\"qbittorrent.*.tags\",\"Operator\":\"Contains\",\"Value\":\"stale\"},{\"kind\":\"comparison\",\"Field\":\"tautulli.*.days_since_watched\",\"Operator\":\"Lte\",\"Value\":90}]}",
      "ActionsJson": "[{\"type\":\"remove_tags\",\"Tags\":[\"stale\"]}]",
      "TargetInstanceIdsJson": "[]"
    },
    {
      "Name": "Throttle upload for archived category",
      "Description": "Caps upload speed on anything filed under the 'archived' category to keep bandwidth free for active downloads.",
      "Enabled": true,
      "Priority": 20,
      "StopOnMatch": false,
      "DryRun": true,
      "CronExpression": "*/30 * * * *",
      "TimeZoneId": "UTC",
      "UseAdvancedSql": false,
      "ConditionTreeJson": "{\"kind\":\"group\",\"Operator\":\"And\",\"Children\":[{\"kind\":\"comparison\",\"Field\":\"qbittorrent.*.category\",\"Operator\":\"Eq\",\"Value\":\"archived\"}]}",
      "ActionsJson": "[{\"type\":\"set_upload_limit\",\"LimitBytesPerSec\":500000}]",
      "TargetInstanceIdsJson": "[]"
    },
    {
      "Name": "Move completed & unwatched to cold storage",
      "Description": "Once a torrent finishes downloading and has no recent watch history, relocate it off primary storage.",
      "Enabled": true,
      "Priority": 30,
      "StopOnMatch": false,
      "DryRun": true,
      "CronExpression": "0 5 * * *",
      "TimeZoneId": "UTC",
      "UseAdvancedSql": false,
      "ConditionTreeJson": "{\"kind\":\"group\",\"Operator\":\"And\",\"Children\":[{\"kind\":\"comparison\",\"Field\":\"qbittorrent.*.progress\",\"Operator\":\"Gte\",\"Value\":1.0},{\"kind\":\"exists\",\"Source\":\"tautulli.*\",\"Negate\":true,\"Condition\":{\"kind\":\"comparison\",\"Field\":\"tautulli.*.days_since_watched\",\"Operator\":\"Lte\",\"Value\":90}}]}",
      "ActionsJson": "[{\"type\":\"move\",\"DestinationPath\":\"/media/cold-storage\",\"WaitForCompletion\":true}]",
      "TargetInstanceIdsJson": "[]"
    },
    {
      "Name": "Tag large completed torrents (20GB+)",
      "Description": "Flags large finished downloads for review, e.g. before a manual cleanup pass.",
      "Enabled": true,
      "Priority": 40,
      "StopOnMatch": false,
      "DryRun": true,
      "CronExpression": "0 6 * * *",
      "TimeZoneId": "UTC",
      "UseAdvancedSql": false,
      "ConditionTreeJson": "{\"kind\":\"group\",\"Operator\":\"And\",\"Children\":[{\"kind\":\"comparison\",\"Field\":\"qbittorrent.*.progress\",\"Operator\":\"Gte\",\"Value\":1.0},{\"kind\":\"comparison\",\"Field\":\"qbittorrent.*.size_gb\",\"Operator\":\"Gt\",\"Value\":20}]}",
      "ActionsJson": "[{\"type\":\"add_tags\",\"Tags\":[\"large\"]}]",
      "TargetInstanceIdsJson": "[]"
    },
    {
      "Name": "Flag downloads when storage is low",
      "Description": "Tags active downloads in the 'downloads' category whenever the named storage path is over 85% used. Requires a storage path named 'downloads' configured under Instances.",
      "Enabled": true,
      "Priority": 1,
      "StopOnMatch": false,
      "DryRun": true,
      "CronExpression": "*/15 * * * *",
      "TimeZoneId": "UTC",
      "UseAdvancedSql": false,
      "ConditionTreeJson": "{\"kind\":\"group\",\"Operator\":\"And\",\"Children\":[{\"kind\":\"comparison\",\"Field\":\"qbittorrent.*.category\",\"Operator\":\"Eq\",\"Value\":\"downloads\"},{\"kind\":\"comparison\",\"Field\":\"storage.downloads.used_percent\",\"Operator\":\"Gt\",\"Value\":85}]}",
      "ActionsJson": "[{\"type\":\"add_tags\",\"Tags\":[\"low-disk-space\"]}]",
      "TargetInstanceIdsJson": "[]"
    },
    {
      "Name": "Unlimited upload for priority category",
      "Description": "Removes any upload cap on torrents filed under the 'priority' category.",
      "Enabled": true,
      "Priority": 15,
      "StopOnMatch": false,
      "DryRun": true,
      "CronExpression": "*/30 * * * *",
      "TimeZoneId": "UTC",
      "UseAdvancedSql": false,
      "ConditionTreeJson": "{\"kind\":\"group\",\"Operator\":\"And\",\"Children\":[{\"kind\":\"comparison\",\"Field\":\"qbittorrent.*.category\",\"Operator\":\"Eq\",\"Value\":\"priority\"}]}",
      "ActionsJson": "[{\"type\":\"set_upload_limit\",\"LimitBytesPerSec\":0}]",
      "TargetInstanceIdsJson": "[]"
    },
    {
      "Name": "Flag old, never-watched torrents",
      "Description": "Torrents added 180+ days ago whose linked media has never once been played -- good candidates for deletion review. play_count aggregates every watch event for the torrent's content, so 0 means never watched.",
      "Enabled": true,
      "Priority": 50,
      "StopOnMatch": false,
      "DryRun": true,
      "CronExpression": "0 7 * * 0",
      "TimeZoneId": "UTC",
      "UseAdvancedSql": false,
      "ConditionTreeJson": "{\"kind\":\"group\",\"Operator\":\"And\",\"Children\":[{\"kind\":\"comparison\",\"Field\":\"qbittorrent.*.days_since_added\",\"Operator\":\"Gt\",\"Value\":180},{\"kind\":\"comparison\",\"Field\":\"tautulli.*.play_count\",\"Operator\":\"Eq\",\"Value\":0}]}",
      "ActionsJson": "[{\"type\":\"add_tags\",\"Tags\":[\"review-for-deletion\"]}]",
      "TargetInstanceIdsJson": "[]"
    },
    {
      "Name": "Flag torrents missing from the media library",
      "Description": "Finished torrents that no Jellyfin library item points at -- either the library hasn't scanned them yet, or nothing is using them.",
      "Enabled": true,
      "Priority": 60,
      "StopOnMatch": false,
      "DryRun": true,
      "CronExpression": "0 8 * * 0",
      "TimeZoneId": "UTC",
      "UseAdvancedSql": false,
      "ConditionTreeJson": "{\"kind\":\"group\",\"Operator\":\"And\",\"Children\":[{\"kind\":\"comparison\",\"Field\":\"qbittorrent.*.progress\",\"Operator\":\"Gte\",\"Value\":1.0},{\"kind\":\"comparison\",\"Field\":\"jellyfin.*.media_count\",\"Operator\":\"Eq\",\"Value\":0}]}",
      "ActionsJson": "[{\"type\":\"add_tags\",\"Tags\":[\"not-in-library\"]}]",
      "TargetInstanceIdsJson": "[]"
    }
  ]
}
