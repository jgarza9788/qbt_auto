# local runtime data / volumes (docker-compose bind mounts at the repo root).
# These MUST stay anchored with a leading slash: unanchored "data/" and "config/" also match
# src/QbitFlow.Infrastructure/Data|Config, which silently excluded the whole EF layer and every
# migration from the repository.
/data/
/exports/
/scripts/
/config/
*.db
*.db-shm
*.db-wal
qbitflow.design.db
qbitflow-test-*.db

# secrets / user config
config.json
