<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Qbitflow.Core\Qbitflow.Core.csproj" />
    <ProjectReference Include="..\Qbitflow.Sources\Qbitflow.Sources.csproj" />
    <ProjectReference Include="..\Qbitflow.Snapshot\Qbitflow.Snapshot.csproj" />
    <ProjectReference Include="..\Qbitflow.Engine\Qbitflow.Engine.csproj" />
    <ProjectReference Include="..\Qbitflow.Infrastructure\Qbitflow.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Design-time only: without this condition the package's IncludeAssets
         override drags the whole Roslyn/MSBuild toolchain (~15 MB) into the
         Release publish, and so into the runtime image. dotnet ef builds Debug
         by default, so migrations tooling is unaffected. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0"
                      Condition="'$(Configuration)' == 'Debug'">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NLog.Web.AspNetCore" Version="6.2.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- The UI is English-only. Without this, publish emits 93 translated
         resource assemblies across 30 locale directories (~7.4 MB) holding
         nothing but localised framework exception messages. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
