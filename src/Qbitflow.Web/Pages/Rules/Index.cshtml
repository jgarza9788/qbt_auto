@page
@model Qbitflow.Web.Pages.Rules.IndexModel
@{
    ViewData["Title"] = "Rules";
}

<div class="qf-card">
    <div class="qf-card-header">
        <h2>Rules</h2>
        <div class="d-flex align-items-center gap-2">
            @if (Model.Rules.Count > 0)
            {
                <input type="search" class="form-control form-control-sm qf-table-filter"
                       data-table-filter placeholder="Filter&hellip;" aria-label="Filter rules" />
            }
            <a asp-page="/Rules/Edit" class="btn btn-sm btn-primary qf-ico-btn"><span class="qf-icon qf-icon--add" aria-hidden="true"></span>Add rule</a>
        </div>
    </div>
    <div class="qf-card-body p-0">
        @if (Model.Rules.Count == 0)
        {
            <div class="qf-empty">
                <div class="qf-empty-icon qf-icon qf-icon--rules" aria-hidden="true"></div>
                <p class="mb-2">No rules yet. A rule is a schedule, a condition, and one or more actions.</p>
                <a asp-page="/Rules/Edit" class="btn btn-sm btn-primary qf-ico-btn"><span class="qf-icon qf-icon--add" aria-hidden="true"></span>Create your first rule</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead>
                    <tr>
                        <th>Status</th>
                        <th>Priority</th>
                        <th>Name</th>
                        <th>Schedule</th>
                        <th>Last run</th>
                        <th class="text-end">Actions</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var rule in Model.Rules)
                    {
                        <tr>
                            <td>
                                <form method="post" asp-page-handler="ToggleEnabled" asp-route-id="@rule.Id">
                                    <button type="submit" class="btn btn-sm p-0 border-0 bg-transparent">
                                        @if (rule.Enabled)
                                        {
                                            <span class="qf-badge qf-badge-success"><span class="qf-badge-dot"></span>on</span>
                                        }
                                        else
                                        {
                                            <span class="qf-badge qf-badge-secondary"><span class="qf-badge-dot"></span>off</span>
                                        }
                                    </button>
                                </form>
                            </td>
                            <td class="text-secondary">@rule.Priority</td>
                            <td>
                                <div class="fw-medium">@rule.Name</div>
                                @if (!string.IsNullOrEmpty(rule.Description))
                                {
                                    <div class="small text-secondary">@rule.Description</div>
                                }
                                @if (rule.DryRun)
                                {
                                    <span class="qf-badge qf-badge-secondary">dry-run</span>
                                }
                            </td>
                            <td class="small">
                                @Qbitflow.Engine.Scheduling.CronDescriptionService.Describe(rule.CronExpression)
                                <div class="qf-muted-mono">@rule.CronExpression (@rule.TimeZoneId)</div>
                            </td>
                            <td class="text-secondary small">@(rule.LastRunAt is not null ? rule.LastRunAt.Value.LocalDateTime.ToString("g") : "never")</td>
                            <td class="text-end">
                                <form method="post" asp-page-handler="RunNow" asp-route-id="@rule.Id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-success qf-ico-btn"><span class="qf-icon qf-icon--play" aria-hidden="true"></span>Run now</button>
                                </form>
                                <a asp-page="/Rules/Edit" asp-route-id="@rule.Id" class="btn btn-sm btn-outline-secondary qf-ico-btn"><span class="qf-icon qf-icon--edit" aria-hidden="true"></span>Edit</a>
                                <form method="post" asp-page-handler="Duplicate" asp-route-id="@rule.Id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary qf-ico-btn"><span class="qf-icon qf-icon--copy" aria-hidden="true"></span>Duplicate</button>
                                </form>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@rule.Id" class="d-inline"
                                      onsubmit="return confirm('Delete rule &quot;@rule.Name&quot;?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger qf-ico-btn"><span class="qf-icon qf-icon--delete" aria-hidden="true"></span>Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
