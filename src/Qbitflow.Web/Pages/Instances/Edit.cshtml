@page "{id:int?}"
@model Qbitflow.Web.Pages.Instances.EditModel
@{
    ViewData["Title"] = Model.IsNew ? "Add instance" : "Edit instance";
}

@* Per-source-type help text. Every hint below is rendered server-side for the currently
   selected type first, then kept in sync by Alpine as the dropdown changes -- so the form is
   correct on first paint and without JavaScript. *@
<div id="qf-instance-guide-data" data-source-guide="@Model.SourceGuideJson" hidden></div>
<script>
    (function () {
        window.qfSourceGuide = JSON.parse(document.getElementById('qf-instance-guide-data').dataset.sourceGuide);
    })();
</script>

<div class="qf-card" style="max-width: 640px; margin: 0 auto;">
    <div class="qf-card-header">
        <h2>@(Model.IsNew ? "Add instance" : $"Edit instance: {Model.Input.Name}")</h2>
    </div>
    <div class="qf-card-body">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <form method="post"
              x-data="{ sourceType: '@Model.Input.SourceType', get guide() { return window.qfSourceGuide[this.sourceType]; } }">
            <input type="hidden" asp-for="Input.Id" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Input.Name" class="form-label"></label>
                    <input asp-for="Input.Name" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.SourceType" class="form-label"></label>
                    @* Options are built from the guide rather than GetEnumSelectList so their values are
                       enum names, which is what keys window.qfSourceGuide. Model binding accepts names. *@
                    <select asp-for="Input.SourceType" class="form-select" x-model="sourceType">
                        @foreach (var (value, label) in Model.SourceTypeOptions)
                        {
                            <option value="@value">@label</option>
                        }
                    </select>
                </div>
                <div class="col-12">
                    <label asp-for="Input.BaseUrl" class="form-label"></label>
                    <input asp-for="Input.BaseUrl" class="form-control"
                           placeholder="@Model.Guide.BaseUrlPlaceholder" :placeholder="guide.baseUrlPlaceholder" />
                    <div class="form-text" x-text="guide.baseUrl">@Model.Guide.BaseUrl</div>
                </div>

                <div class="col-md-6">
                    <label asp-for="Input.Username" class="form-label"></label>
                    <input asp-for="Input.Username" class="form-control" autocomplete="off" />
                    <div class="form-text" x-text="guide.username">@Model.Guide.Username</div>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.Password" class="form-label"></label>
                    <input asp-for="Input.Password" type="password" class="form-control" autocomplete="new-password"
                           placeholder="@(Model.Input.HasExistingPassword ? "Leave blank to keep existing" : "")" />
                    <div class="form-text" x-text="guide.password">@Model.Guide.Password</div>
                </div>
                <div class="col-12">
                    <label asp-for="Input.ApiKey" class="form-label"></label>
                    <input asp-for="Input.ApiKey" type="password" class="form-control" autocomplete="new-password"
                           placeholder="@(Model.Input.HasExistingApiKey ? "Leave blank to keep existing" : "")" />
                    <div class="form-text" x-text="guide.apiKey">@Model.Guide.ApiKey</div>
                </div>

                <div class="col-md-4">
                    <label asp-for="Input.TimeoutSeconds" class="form-label"></label>
                    <input asp-for="Input.TimeoutSeconds" type="number" class="form-control" />
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <div class="form-check">
                        <input asp-for="Input.VerifySsl" class="form-check-input" />
                        <label asp-for="Input.VerifySsl" class="form-check-label"></label>
                    </div>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <div class="form-check">
                        <input asp-for="Input.Enabled" class="form-check-input" />
                        <label asp-for="Input.Enabled" class="form-check-label"></label>
                    </div>
                </div>

                <div class="col-12">
                    <label asp-for="Input.ExtraConfigJson" class="form-label"></label>
                    <textarea asp-for="Input.ExtraConfigJson" class="form-control qf-muted-mono" rows="3"
                              placeholder="@Model.Guide.ExtraConfigPlaceholder"
                              :placeholder="guide.extraConfigPlaceholder"></textarea>
                    <div class="form-text" x-text="guide.extraConfig">@Model.Guide.ExtraConfig</div>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2 align-items-center">
                <button type="submit" class="btn btn-primary qf-ico-btn"><span class="qf-icon qf-icon--save" aria-hidden="true"></span>Save</button>
                <a asp-page="/Instances/Index" class="btn btn-outline-secondary">Cancel</a>
                <button type="button" class="btn btn-outline-secondary ms-auto qf-ico-btn"
                        hx-post="?handler=TestConnection" hx-include="closest form"
                        hx-target="#edit-conn-test-result" hx-swap="innerHTML"
                        hx-indicator="#edit-conn-test-spinner"><span class="qf-icon qf-icon--rotate" aria-hidden="true"></span>Test connection</button>
                <span id="edit-conn-test-spinner" class="htmx-indicator small text-secondary">testing…</span>
            </div>
            <div id="edit-conn-test-result" class="mt-2"></div>
            <div class="form-text">Tests the values entered above (leave the password / API key blank to reuse the saved one).</div>
        </form>
    </div>
</div>
