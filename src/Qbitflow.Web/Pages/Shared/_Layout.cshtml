@using Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - qbitflow</title>
    <script>
        // Applied before first paint so there's no flash of the wrong theme.
        (function () {
            var stored = null;
            try { stored = localStorage.getItem('qbitflow-theme'); } catch (e) {}
            var theme = stored || 'auto';
            if (theme !== 'auto') {
                document.documentElement.setAttribute('data-bs-theme', theme);
            }
        })();
    </script>
    @* Icon glyphs come from the Nerd Fonts symbols webfont rather than a local
       file, so nothing font-shaped ships in the image. Note this makes the icons
       depend on outbound internet access: with no route to nerdfonts.com they
       render as tofu. *@
    <link rel="stylesheet" href="https://www.nerdfonts.com/assets/css/webfont.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Qbitflow.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg border-bottom qf-navbar">
            <div class="container-fluid">
                <a class="qf-logo-link" asp-page="/Index" title="qbitflow">
                    <img src="~/img/icon.svg" alt="qbitflow" class="qf-logo" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#qfNav"
                        aria-controls="qfNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="qfNav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item">
                                <a class="nav-link qf-ico-btn" asp-page="/Index">
                                    <span class="qf-icon qf-icon--dashboard" aria-hidden="true"></span>Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link qf-ico-btn" asp-page="/Rules/Index">
                                    <span class="qf-icon qf-icon--rules" aria-hidden="true"></span>Rules
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link qf-ico-btn" asp-page="/Instances/Index">
                                    <span class="qf-icon qf-icon--plug" aria-hidden="true"></span>Instances
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link qf-ico-btn" asp-page="/History/Index">
                                    <span class="qf-icon qf-icon--clock" aria-hidden="true"></span>History
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link qf-ico-btn" asp-page="/Settings/Index">
                                    <span class="qf-icon qf-icon--gear" aria-hidden="true"></span>Settings
                                </a>
                            </li>
                        </ul>
                        <ul class="navbar-nav">
                            <li class="nav-item d-flex align-items-center">
                                <div class="qf-theme-toggle" role="group" aria-label="Theme">
                                    <button type="button" class="btn" data-theme-choice="light" title="Light" aria-label="Light" aria-pressed="false">
                                        <span class="qf-icon qf-icon--sun" aria-hidden="true"></span>
                                    </button>
                                    <button type="button" class="btn" data-theme-choice="dark" title="Dark" aria-label="Dark" aria-pressed="false">
                                        <span class="qf-icon qf-icon--moon" aria-hidden="true"></span>
                                    </button>
                                    <button type="button" class="btn" data-theme-choice="auto" title="Match system" aria-label="Match system" aria-pressed="false">
                                        <span class="qf-icon qf-icon--auto" aria-hidden="true"></span>
                                    </button>
                                </div>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link qf-ico-btn" asp-page="/Account/ChangePassword">
                                    <span class="qf-icon qf-icon--key" aria-hidden="true"></span>Change password
                                </a>
                            </li>
                            <li class="nav-item">
                                <form method="post" action="/Logout">
                                    <button type="submit" class="btn btn-link nav-link qf-ico-btn">
                                        <span class="qf-icon qf-icon--signout" aria-hidden="true"></span>Log out
                                    </button>
                                </form>
                            </li>
                            <!--
                            <li class="nav-item d-flex align-items-center">
                                <a class="qf-logo-link" asp-page="/Index" title="qbitflow">
                                    <img src="~/img/icon.svg" alt="qbitflow" class="qf-logo" />
                                </a>
                            </li>
                            -->
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid qf-content">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (function () {
            var buttons = document.querySelectorAll('[data-theme-choice]');
            function apply(theme) {
                if (theme === 'auto') {
                    document.documentElement.removeAttribute('data-bs-theme');
                } else {
                    document.documentElement.setAttribute('data-bs-theme', theme);
                }
                try { localStorage.setItem('qbitflow-theme', theme); } catch (e) {}
                buttons.forEach(function (b) {
                    var on = b.getAttribute('data-theme-choice') === theme;
                    b.classList.toggle('active', on);
                    b.setAttribute('aria-pressed', on ? 'true' : 'false');
                });
            }
            buttons.forEach(function (b) {
                b.addEventListener('click', function () { apply(b.getAttribute('data-theme-choice')); });
            });
            var stored = null;
            try { stored = localStorage.getItem('qbitflow-theme'); } catch (e) {}
            apply(stored || 'auto');
        })();
    </script>
    <script src="~/lib/htmx/htmx.min.js"></script>
    <script src="~/lib/alpinejs/alpine.min.js" defer></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
