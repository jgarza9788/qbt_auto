@page "{id:int?}"
@model Qbitflow.Web.Pages.Settings.EditPathMappingModel
@{
    ViewData["Title"] = Model.IsNew ? "Add path mapping" : "Edit path mapping";
}

<div class="qf-card" style="max-width: 560px;">
    <div class="qf-card-header">
        <h2>@(Model.IsNew ? "Add path mapping" : "Edit path mapping")</h2>
    </div>
    <div class="qf-card-body">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <form method="post">
            <input type="hidden" asp-for="Input.Id" />

            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="Input.SourcePrefix" class="form-label"></label>
                    <input asp-for="Input.SourcePrefix" class="form-control qf-muted-mono" placeholder="/downloads" />
                </div>
                <div class="col-12">
                    <label asp-for="Input.CanonicalPrefix" class="form-label"></label>
                    <input asp-for="Input.CanonicalPrefix" class="form-control qf-muted-mono" placeholder="/media/downloads" />
                    <div class="form-text">Any path starting with the source prefix is rewritten onto this prefix before comparison, so a qBittorrent mount and a Plex/Jellyfin mount for the same underlying files match.</div>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input asp-for="Input.Enabled" class="form-check-input" />
                        <label asp-for="Input.Enabled" class="form-check-label"></label>
                    </div>
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-page="/Settings/Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
