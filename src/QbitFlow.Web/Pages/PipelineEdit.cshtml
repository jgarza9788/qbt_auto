@page
@model PipelineEditModel
@{ ViewData["Title"] = $"Edit · {Model.Pipeline.Name}"; }

<section class="panel">
    <div class="spread">
        <h1>@Model.Pipeline.Name</h1>
        <a class="btn ghost" href="/Rules?pipelineId=@Model.Pipeline.Id">Edit rules →</a>
    </div>
</section>

<form method="post" asp-route-id="@Model.Pipeline.Id">
    <section class="panel">
        <h2>Settings</h2>
        <div class="grid2">
            <div><label>Name</label><input asp-for="Name" required></div>
            <div><label>Max parallelism</label><input asp-for="MaxParallelism" type="number" min="1" max="64"></div>
            <div><label>Schedule</label>
                <select asp-for="ScheduleKind"><option>Interval</option><option>Cron</option></select>
            </div>
            <div><label>Interval (seconds, min 300)</label><input asp-for="IntervalSeconds" type="number" min="300" placeholder="900"></div>
            <div><label>Cron expression (6-field, incl. seconds)</label><input asp-for="CronExpression" class="mono" placeholder="0 */15 * * * *"></div>
            <div><label>Time zone</label><input asp-for="TimeZoneId" placeholder="UTC"></div>
        </div>
        <div class="row" style="margin-top:12px">
            <label class="row"><input type="checkbox" asp-for="Enabled" style="width:auto"> Enabled</label>
            <label class="row"><input type="checkbox" asp-for="DryRun" style="width:auto"> Dry-run (log only)</label>
            <label class="row"><input type="checkbox" asp-for="StopOnFirstMatch" style="width:auto"> Stop on first matching rule</label>
        </div>
    </section>

    <section class="panel">
        <h2>Sources</h2>
        <p class="muted">Data = feeds this pipeline. Target = torrents are fetched from and actions applied to it (qBittorrent only).</p>
        <div class="scroll-x">
            <table>
                <tr><th>Source</th><th>Kind</th><th>Data</th><th>Action target</th></tr>
                @foreach (var s in Model.AllSources)
                {
                    <tr>
                        <td>@s.Name</td><td>@s.Kind</td>
                        <td><input type="checkbox" name="DataSourceIds" value="@s.Id" style="width:auto" @(Model.DataSourceIds.Contains(s.Id) ? "checked" : "")></td>
                        <td>
                            @if (s.Kind == QbitFlow.Core.Domain.SourceKind.Qbt)
                            {
                                <input type="checkbox" name="TargetIds" value="@s.Id" style="width:auto" @(Model.TargetIds.Contains(s.Id) ? "checked" : "")>
                            }
                            else { <span class="muted">—</span> }
                        </td>
                    </tr>
                }
            </table>
        </div>
    </section>

    <div class="row"><button type="submit">Save</button><a class="btn ghost" href="/Pipelines">Back</a></div>
</form>
