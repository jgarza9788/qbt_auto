@page
@model PipelinesModel
@{ ViewData["Title"] = "Pipelines"; }

<section class="panel">
    <div class="spread">
        <div><h1>Pipelines</h1><span class="muted">Each pipeline is its own schedule. A run refreshes only the qBittorrent target(s) it needs, then evaluates every rule against every torrent.</span></div>
    </div>
    <form method="post" asp-page-handler="Create" class="row" style="margin-top:12px">
        <input asp-for="NewName" placeholder="New pipeline name" style="max-width:280px" required>
        <button type="submit">Create</button>
    </form>
</section>

<section>
    <h2>All pipelines</h2>
    <div class="panel scroll-x">
        <table>
            <tr><th>Name</th><th>State</th><th>Schedule</th><th>Rules</th><th>Targets</th><th></th></tr>
            @if (Model.Pipelines.Count == 0) { <tr><td colspan="6" class="muted">None yet.</td></tr> }
            @foreach (var p in Model.Pipelines)
            {
                <tr>
                    <td><a href="/Rules?pipelineId=@p.Id"><b>@p.Name</b></a></td>
                    <td>
                        @if (p.IsRunning) { <span class="pill run">running</span> }
                        else if (p.Enabled) { <span class="pill ok">enabled</span> }
                        else { <span class="pill">disabled</span> }
                        @if (p.DryRun) { <span class="pill">dry&#8209;run</span> }
                    </td>
                    <td class="muted">@p.Schedule</td>
                    <td>@p.Rules</td>
                    <td>@p.Targets</td>
                    <td>
                        <a class="btn ghost" href="/Rules?pipelineId=@p.Id">Rules</a>
                        <a class="btn ghost" href="/PipelineEdit?id=@p.Id">Settings</a>
                        <form class="inline" method="post" asp-page-handler="Delete" asp-route-id="@p.Id"><button class="danger">Delete</button></form>
                    </td>
                </tr>
            }
        </table>
    </div>
</section>
