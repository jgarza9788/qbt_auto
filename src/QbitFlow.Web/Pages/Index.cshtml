@page
@model IndexModel
@{ ViewData["Title"] = "Dashboard"; }
@functions {
    static string Ago(DateTimeOffset? w)
    {
        if (w is not { } t) return "—";
        var d = DateTimeOffset.UtcNow - t;
        var future = d < TimeSpan.Zero;
        d = d.Duration();
        var s = d.TotalSeconds < 60 ? $"{(int)d.TotalSeconds}s"
            : d.TotalMinutes < 60 ? $"{(int)d.TotalMinutes}m"
            : d.TotalHours < 24 ? $"{(int)d.TotalHours}h" : $"{(int)d.TotalDays}d";
        return future ? $"in {s}" : $"{s} ago";
    }
}

<section class="panel">
    <div class="spread">
        <div><h1>Dashboard</h1><span class="muted">@Model.Sources.Total source(s) · @Model.Sources.Healthy healthy · @Model.Sources.Bad down · analytics @Ago(Model.AnalyticsLastRun)</span></div>
        <a class="btn ghost" href="/Rules">Edit rules</a>
    </div>
</section>

<section class="panel">
    <div class="spread">
        <div>
            <h2>Rule engine</h2>
            <span class="muted">
                @if (Model.EngineRunning) { <span class="pill run">running</span> }
                else if (Model.Engine.Enabled) { <span class="pill ok">enabled</span> }
                else { <span class="pill">paused</span> }
                @if (Model.Engine.DryRun) { <span class="pill">dry&#8209;run</span> }
                · @Model.EnabledRules of @Model.TotalRules rule(s) enabled
                · every @Model.Engine.IntervalSeconds s
                · last @Ago(Model.LastRunUtc) · next @Ago(Model.NextRunUtc)
            </span>
        </div>
        <div class="row">
            <form class="inline" method="post" asp-page-handler="Run"><button>Run now</button></form>
            <form class="inline" method="post" asp-page-handler="Toggle"><button class="ghost">@(Model.Engine.Enabled ? "Pause" : "Resume")</button></form>
        </div>
    </div>
</section>

<section>
    <h2>Recent runs</h2>
    <div class="panel scroll-x">
        <table>
            <tr><th>Status</th><th>Started</th><th>Duration</th><th>Applied</th><th>Would</th><th>Errors</th><th></th></tr>
            @if (Model.Runs.Count == 0) { <tr><td colspan="7" class="muted">No runs yet.</td></tr> }
            @foreach (var r in Model.Runs)
            {
                <tr>
                    <td>
                        <span class="pill @(r.Status switch { "Succeeded" => "ok", "Running" => "run", "Failed" => "err", _ => "" })">@r.Status.ToLower()</span>
                        @if (r.DryRun) { <span class="pill">dry</span> }
                    </td>
                    <td class="muted">@Ago(r.StartedUtc)</td>
                    <td class="muted">@(r.DurationMs) ms</td>
                    <td>@r.Applied</td><td>@r.WouldApply</td><td>@r.Errors</td>
                    <td><a href="/RunDetail?id=@r.Id">view</a></td>
                </tr>
            }
        </table>
    </div>
</section>
