@page
@model RulesModel
@{ ViewData["Title"] = "Rules"; }

<form method="post" id="rules-form">
    <div asp-validation-summary="All" class="muted"></div>

    <section class="panel" id="rules">
        <div class="spread">
            <div><h1>Rules</h1><span class="muted">One global list. Evaluated top to bottom against every torrent, every pass. Drag to reorder. Nothing is saved until you press Save.</span></div>
            <div class="row">
                <button type="button" class="ghost" id="open-fields">Fields ▸</button>
                <button type="button" id="btn-new">New rule</button>
            </div>
        </div>

        <div class="scroll-x" style="margin-top:10px">
            <table>
                <thead><tr><th></th><th>#</th><th>Name</th><th>Expression</th><th>Action</th><th>On</th><th></th></tr></thead>
                <tbody id="rule-rows"></tbody>
            </table>
        </div>
    </section>

    <section class="panel" id="editor-section">
        <h2>Rule editor</h2>
        <p class="muted" id="editor-empty">Pick a rule to edit, or add a new one.</p>

        <div id="editor" hidden>
            <h3 id="editor-title">New rule</h3>
            <input type="hidden" id="rule-key">
            <div class="grid2">
                <div><label>Name</label><input id="rule-name" placeholder="Tag cold movies"></div>
                <div><label>Mode</label>
                    <select id="rule-mode"><option value="Builder">Builder</option><option value="Raw">Raw expression</option></select>
                </div>
            </div>

            <fieldset id="builder-pane">
                <legend>Conditions</legend>
                <div class="row"><label style="margin:0">Combine with</label>
                    <select id="grp-logic" style="width:auto"><option value="And">AND</option><option value="Or">OR</option></select>
                </div>
                <div id="cond-rows" style="margin-top:8px"></div>
                <button type="button" class="ghost" id="btn-add-cond" style="margin-top:8px">+ condition</button>
            </fieldset>

            <fieldset id="raw-pane" hidden>
                <legend>Raw DynamicExpresso expression</legend>
                <textarea id="rule-raw" placeholder='(&lt;Size&gt; &lt; 1073741824) &amp;&amp; match("&lt;Name&gt;", "1080p")'></textarea>
            </fieldset>

            <label>Compiled</label>
            <div class="compiled" id="compiled">true</div>

            <div class="grid2" style="margin-top:8px">
                <div><label>Action</label><select id="rule-action"></select></div>
                <div><label>Action parameters (JSON)</label><input id="rule-params" class="mono" value="{}"></div>
            </div>
            <p class="muted" id="action-help"></p>

            <div class="grid2" style="margin-top:8px">
                <div><label>Target qBittorrent instances</label>
                    <div id="rule-targets" class="row" style="gap:14px">
                        @if (Model.QbtSources.Count == 0) { <span class="muted">No qBittorrent sources yet.</span> }
                        @foreach (var s in Model.QbtSources)
                        {
                            <label class="row" style="margin:0"><input type="checkbox" class="t-target" value="@s.Id" style="width:auto"> @s.Name</label>
                        }
                    </div>
                    <span class="muted">None checked = every enabled qBittorrent source.</span>
                </div>
                <div><label>Cooldown (seconds, blank = none)</label>
                    <input id="rule-cooldown" type="number" min="0" placeholder="none">
                    <span class="muted">Won't re-fire against the same torrent within this window.</span>
                </div>
            </div>

            <label class="row" style="margin-top:8px"><input type="checkbox" id="rule-enabled" checked style="width:auto"> Enabled</label>
            <label class="row"><input type="checkbox" id="rule-stop" style="width:auto"> Stop at this rule if it matches</label>

            <div class="row" style="margin-top:14px">
                <button type="button" id="btn-apply">Apply</button>
                <button type="button" class="ghost" id="btn-test">Test against current torrents</button>
                <button type="button" class="ghost" id="btn-cancel">Cancel</button>
            </div>
            <div id="test-out" style="margin-top:14px"></div>
        </div>
    </section>

    <input type="hidden" asp-for="RulesPayload" id="rules-payload">
    <div class="row"><button type="submit" id="btn-save">Save</button><a class="btn ghost" href="/">Back</a></div>
</form>

<dialog id="fields-dialog" class="slideover" aria-label="Field reference">
    <div class="slideover-inner">
        <div class="spread">
            <b>Field reference</b>
            <button type="button" class="ghost" id="close-fields" aria-label="Close">✕</button>
        </div>
        <p class="muted" style="margin:0">Placeholders usable in rule conditions and action parameters.</p>
        <input id="fields-filter" placeholder="filter fields…" autocomplete="off">
        <div id="fields-list">
            @foreach (var group in RulesModel.Fields.GroupBy(f => f.Source))
            {
                <h3>@group.Key</h3>
                @foreach (var f in group)
                {
                    <div class="fref" data-text="@($"{f.Placeholder} {f.Description} {f.Type}".ToLowerInvariant())">
                        <div class="spread">
                            <span class="mono">@f.Placeholder</span>
                            <span class="row" style="gap:8px">
                                <span class="muted">@f.Type</span>
                                <button type="button" class="ghost copy-field" data-ph="@f.Placeholder">copy</button>
                            </span>
                        </div>
                        <div class="muted">@f.Description</div>
                        <div class="muted mono" style="font-size:12px">e.g. @f.Sample</div>
                    </div>
                }
            }
            <h3>Drive</h3>
            <div class="fref" data-text="drive mount totalsizegb freesizegb usedsizegb free space disk">
                <div class="muted">
                    Generated per mounted drive by the engine — not listed above. Keys look like
                    <span class="mono">&lt;mount&gt;_TotalSizeGB</span>, <span class="mono">&lt;mount&gt;_FreeSizeGB</span>,
                    <span class="mono">&lt;mount&gt;_UsedSizeGB</span>; the exact names depend on the container's mounts.
                </div>
            </div>
        </div>
    </div>
</dialog>

@section Scripts {
<script>
/*
 * The rule list is edited entirely client-side against a draft array. Adding, editing, reordering,
 * toggling and deleting mutate RULES in memory and re-render — no network calls — and the whole list
 * is posted as one JSON blob in #rules-payload when you press Save. RuleWriter.ReconcileAsync then
 * makes the stored list match the payload exactly, in one transaction.
 *
 * Two server round-trips remain while editing, because they need the engine:
 *   POST /api/rules/compile  — live "Compiled" preview of the builder tree
 *   POST /api/rules/test     — "Test against current torrents" (read-only)
 *
 * Each entry carries a client-only `_key` for DOM identity. Saved rules reuse their server `Id`;
 * a brand-new rule gets a random one and sends `id: null` so the server knows to insert it.
 */
const FIELDS = @Html.Raw(Model.FieldsJson);
const ACTIONS = @Html.Raw(Model.ActionsJson);
let RULES = (@Html.Raw(Model.RulesJson)).map(r => ({ ...r, _key: r.Id || crypto.randomUUID() }));

const $ = s => document.querySelector(s);
const csrf = () => ({ [document.querySelector('meta[name=csrf-header]').content]: document.querySelector('meta[name=csrf-token]').content });
const jhead = () => ({ 'content-type': 'application/json', ...csrf() });
const esc = s => (s ?? '').replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));

// Warn before losing unsaved edits; clear the flag once the form is actually submitting.
let dirty = false;
function markDirty() { dirty = true; }
window.addEventListener('beforeunload', e => { if (dirty) { e.preventDefault(); e.returnValue = ''; } });
$('#rules-form').addEventListener('submit', () => { syncPayload(); dirty = false; });
$('#rules-form').addEventListener('input', markDirty);

// ---- draft payload ----
// Shapes below must match RuleWriter.RuleDraft / GroupDto / CondDto (System.Text.Json web defaults,
// so camelCase here binds to PascalCase there).

// Rules loaded from the server spell the operator `op`; the editor writes `operator`. Accept both.
function normGroup(g) {
  return {
    logic: (g && g.logic) || 'And',
    conditions: ((g && g.conditions) || []).map(c => ({
      field: c.field, operator: c.operator || c.op || 'Eq',
      valueKind: c.valueKind || 'String', value: c.value ?? '',
    })),
    children: [],
  };
}
function toDraft(r, i) {
  const raw = r.mode === 'Raw';
  return {
    id: r.Id || null,          // null => insert
    name: (r.Name || '').trim() || 'rule',
    order: i,                  // array position is the persisted order
    enabled: !!r.Enabled,
    stopOnMatch: (r.StopOnMatch ?? null),   // null => inherit the global setting
    mode: r.mode || 'Builder',
    rawExpression: raw ? (r.RawExpression || 'true') : null,
    group: raw ? null : normGroup(r.group),
    actionType: r.actionType,
    actionParamsJson: r.actionParamsJson || '{}',
    targetIds: (r.targetIds && r.targetIds.length) ? r.targetIds : null,   // null => all instances
    cooldownSeconds: (r.CooldownSeconds ?? null),                          // null => no throttle
  };
}
// Called after every mutation and immediately before submit, so the hidden field is never stale.
function syncPayload() {
  $('#rules-payload').value = JSON.stringify(RULES.map(toDraft));
}

// ---- rule list ----
function renderRules() {
  const tb = $('#rule-rows');
  tb.innerHTML = RULES.map((r, i) => `
    <tr data-key="${r._key}">
      <td class="drag" style="cursor:grab">⠿</td>
      <td>${i + 1}</td>
      <td><b>${esc(r.Name)}</b>${r.CompileValid === false ? ' <span class="pill err">invalid</span>' : ''}</td>
      <td class="mono muted" style="max-width:340px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(r.CompiledExpression)}</td>
      <td class="mono">${esc(r.actionType)}</td>
      <td><input type="checkbox" ${r.Enabled ? 'checked' : ''} data-key="${r._key}" class="row-enabled" style="width:auto"></td>
      <td><button type="button" class="ghost row-edit" data-key="${r._key}">Edit</button>
          <button type="button" class="danger row-del" data-key="${r._key}">Del</button></td>
    </tr>`).join('') || '<tr><td colspan="7" class="muted">No rules yet.</td></tr>';

  tb.querySelectorAll('.row-enabled').forEach(el => el.onchange = () => {
    const r = RULES.find(x => x._key === el.dataset.key);
    if (r) { r.Enabled = el.checked; syncPayload(); markDirty(); }
  });
  tb.querySelectorAll('.row-edit').forEach(el => el.onclick = () => openEditor(RULES.find(x => x._key === el.dataset.key)));
  tb.querySelectorAll('.row-del').forEach(el => el.onclick = () => {
    if (!confirm('Remove this rule?')) return;
    RULES = RULES.filter(x => x._key !== el.dataset.key);
    renderRules(); syncPayload(); markDirty();
  });

  // Drag-to-reorder writes back into RULES; the array order is what gets saved.
  // The dataset.key check skips the "No rules yet." placeholder row.
  if (window.Sortable && tb.children.length && tb.children[0].dataset.key) {
    Sortable.create(tb, {
      handle: '.drag', animation: 120,
      onEnd: () => {
        const order = [...tb.children].map(tr => tr.dataset.key);
        RULES.sort((a, b) => order.indexOf(a._key) - order.indexOf(b._key));
        renderRules(); syncPayload(); markDirty();
      },
    });
  }
}

// ---- editor ----
// Edits are staged here and only reach RULES on Apply, so Cancel discards them.
function actionOptions() {
  $('#rule-action').innerHTML = ACTIONS.map(a => `<option value="${a.Type}">${esc(a.name)} (${a.Type})</option>`).join('');
}
function fieldOptions(sel) {
  return FIELDS.map(f => `<option value="${f.Key}" ${f.Key === sel ? 'selected' : ''}>${f.Key} · ${f.type}</option>`).join('');
}
const OPS = ['Eq','Neq','Gt','Gte','Lt','Lte','Contains','NotContains','Matches','NotMatches','InList','DaysAgoGte','DaysAgoLt','IsTrue','IsFalse'];
function condRow(c = { field: 'Category', op: 'Eq', value: '' }) {
  const div = document.createElement('div');
  div.className = 'row cond';
  div.style.marginBottom = '6px';
  div.innerHTML = `
    <select class="c-field" style="width:220px">${fieldOptions(c.field)}</select>
    <select class="c-op" style="width:130px">${OPS.map(o => `<option ${o === (c.op || c.operator) ? 'selected' : ''}>${o}</option>`).join('')}</select>
    <input class="c-val" style="width:180px" value="${esc(c.value)}" placeholder="value">
    <button type="button" class="ghost c-del">✕</button>`;
  div.querySelector('.c-del').onclick = () => { div.remove(); compile(); };
  div.querySelectorAll('select,input').forEach(el => el.addEventListener('input', compile));
  return div;
}
function readGroup() {
  return {
    logic: $('#grp-logic').value,
    conditions: [...document.querySelectorAll('#cond-rows .cond')].map(r => ({
      field: r.querySelector('.c-field').value,
      operator: r.querySelector('.c-op').value,
      valueKind: 'String',
      value: r.querySelector('.c-val').value,
    })),
    children: [],
  };
}
// Debounced live preview of the "Compiled" box. Raw mode needs no server round-trip — the raw text
// *is* the expression — so only the builder calls /api/rules/compile.
let compileTimer;
function compile() {
  clearTimeout(compileTimer);
  compileTimer = setTimeout(async () => {
    const box = $('#compiled');
    if ($('#rule-mode').value === 'Raw') { box.textContent = $('#rule-raw').value || 'true'; box.classList.remove('bad'); return; }
    const res = await fetch('/api/rules/compile', { method: 'POST', headers: jhead(), body: JSON.stringify(readGroup()) }).then(r => r.json());
    box.textContent = res.expression;
    box.classList.toggle('bad', !res.valid);
  }, 250);
}
function showActionHelp() {
  const a = ACTIONS.find(x => x.Type === $('#rule-action').value);
  $('#action-help').textContent = a ? a.params.map(p => `${p.Key}${p.Required ? '*' : ''}: ${p.Label}${p.Help ? ' — ' + p.Help : ''}`).join('  ·  ') : '';
}
function modePane() {
  const b = $('#rule-mode').value === 'Builder';
  $('#builder-pane').hidden = !b;
  $('#raw-pane').hidden = b;
  compile();
}
// Nothing checked means "every enabled qBittorrent source" — see Rule.TargetFilterJson.
function readTargets() {
  return [...document.querySelectorAll('#rule-targets .t-target:checked')].map(el => el.value);
}
// Loads a rule into the editor, or resets it for a new one when `r` is null.
function openEditor(r) {
  $('#editor').hidden = false;
  $('#editor-empty').hidden = true;
  $('#editor-title').textContent = r ? `Edit — ${r.Name}` : 'New rule';
  $('#rule-key').value = r ? r._key : '';
  $('#rule-name').value = r ? r.Name : '';
  $('#rule-mode').value = r ? (r.mode || 'Builder') : 'Builder';
  $('#rule-enabled').checked = r ? !!r.Enabled : true;
  $('#rule-stop').checked = r ? !!r.StopOnMatch : false;
  $('#rule-raw').value = r && r.RawExpression ? r.RawExpression : '';
  $('#rule-action').value = r ? r.actionType : ACTIONS[0].Type;
  $('#rule-params').value = r ? r.actionParamsJson : '{}';
  $('#rule-cooldown').value = (r && r.CooldownSeconds != null) ? r.CooldownSeconds : '';
  const targets = (r && r.targetIds) ? r.targetIds : [];
  document.querySelectorAll('#rule-targets .t-target').forEach(el => el.checked = targets.includes(el.value));
  $('#grp-logic').value = r && r.group ? r.group.logic : 'And';
  $('#cond-rows').innerHTML = '';
  const conds = (r && r.group && r.group.conditions) ? r.group.conditions : [];
  (conds.length ? conds : [{ field: 'Category', op: 'Eq', value: '' }]).forEach(c =>
    $('#cond-rows').appendChild(condRow(c)));
  modePane(); showActionHelp(); compile();
  $('#test-out').innerHTML = '';
  $('#editor').scrollIntoView({ behavior: 'smooth' });
}

// Apply stages the editor back into RULES (still not saved). It recompiles synchronously so the
// list row shows the right expression and "invalid" badge immediately.
$('#btn-apply').onclick = async () => {
  const key = $('#rule-key').value;
  const builder = $('#rule-mode').value === 'Builder';
  const group = builder ? readGroup() : null;
  let compiled = $('#rule-raw').value || 'true', valid = true;
  if (builder) {
    const res = await fetch('/api/rules/compile', { method: 'POST', headers: jhead(), body: JSON.stringify(group) }).then(r => r.json());
    compiled = res.expression; valid = res.valid;
  }
  const cd = parseInt($('#rule-cooldown').value, 10);
  const draft = {
    Name: $('#rule-name').value.trim() || 'rule',
    Enabled: $('#rule-enabled').checked,
    StopOnMatch: $('#rule-stop').checked ? true : null,
    mode: $('#rule-mode').value,
    RawExpression: builder ? null : $('#rule-raw').value,
    group,
    actionType: $('#rule-action').value,
    actionParamsJson: $('#rule-params').value || '{}',
    targetIds: readTargets(),
    CooldownSeconds: Number.isFinite(cd) && cd > 0 ? cd : null,
    CompiledExpression: compiled,
    CompileValid: valid,
  };
  const existing = key ? RULES.find(x => x._key === key) : null;
  if (existing) Object.assign(existing, draft);
  else RULES.push({ ...draft, Id: null, _key: crypto.randomUUID() });
  $('#editor').hidden = true;
  $('#editor-empty').hidden = false;
  renderRules(); syncPayload(); markDirty();
};
// Evaluates the in-progress condition against real torrents. Read-only: no action is invoked and
// no run is recorded, so it is safe to hit repeatedly while tuning an expression.
$('#btn-test').onclick = async () => {
  const builder = $('#rule-mode').value === 'Builder';
  const draft = {
    name: $('#rule-name').value.trim() || 'rule',
    mode: $('#rule-mode').value,
    rawExpression: builder ? null : $('#rule-raw').value,
    group: builder ? readGroup() : null,
    targetIds: readTargets(),
  };
  $('#test-out').innerHTML = '<span class="muted">running…</span>';
  const rep = await fetch('/api/rules/test', { method: 'POST', headers: jhead(), body: JSON.stringify(draft) }).then(r => r.json());
  $('#test-out').innerHTML = `
    <p class="muted">${rep.Evaluated} evaluated · ${rep.Matched} match · ${rep.Errored} error</p>
    <div class="scroll-x"><table><tr><th>Torrent</th><th>Category</th><th>Result</th></tr>
    ${rep.Rows.map(x => `<tr><td>${esc(x.TorrentName)}</td><td class="muted">${esc(x.Category)}</td>
      <td>${x.Matched === true ? '<span class="pill ok">match</span>' : x.Matched === false ? '<span class="pill">no</span>' : '<span class="pill err">error</span>'}</td></tr>`).join('')}
    </table></div>`;
};
$('#btn-cancel').onclick = () => { $('#editor').hidden = true; $('#editor-empty').hidden = false; };
$('#btn-new').onclick = () => openEditor(null);
$('#btn-add-cond').onclick = () => { $('#cond-rows').appendChild(condRow()); compile(); };
$('#rule-mode').onchange = modePane;
$('#rule-raw').oninput = compile;
$('#grp-logic').onchange = compile;
$('#rule-action').onchange = showActionHelp;

// ---- field reference slide-over ----
// A native <dialog> so Esc, the backdrop and focus handling come for free. It lives outside the
// <form> on purpose: the filter box must not be posted with the rule payload.
const fieldsDlg = $('#fields-dialog');

// Filters on a pre-lowercased data-text blob (placeholder + description + type), then hides any
// group heading whose fields all went away, so the panel never shows an empty section.
function filterFields() {
  const q = $('#fields-filter').value.trim().toLowerCase();
  document.querySelectorAll('#fields-list .fref').forEach(el => {
    el.hidden = q !== '' && !el.dataset.text.includes(q);
  });
  document.querySelectorAll('#fields-list h3').forEach(h => {
    let n = h.nextElementSibling, any = false;
    while (n && n.tagName !== 'H3') {
      if (n.classList.contains('fref') && !n.hidden) any = true;
      n = n.nextElementSibling;
    }
    h.hidden = q !== '' && !any;
  });
}
$('#open-fields').onclick = () => { $('#fields-filter').value = ''; filterFields(); fieldsDlg.showModal(); $('#fields-filter').focus(); };
$('#close-fields').onclick = () => fieldsDlg.close();
fieldsDlg.onclick = e => { if (e.target === fieldsDlg) fieldsDlg.close(); };   // click on the backdrop
$('#fields-filter').oninput = filterFields;
document.querySelectorAll('.copy-field').forEach(b => b.onclick = () => {
  navigator.clipboard.writeText(b.dataset.ph);
  const t = b.textContent; b.textContent = 'copied'; setTimeout(() => b.textContent = t, 900);
});

// ---- boot ----
actionOptions();
renderRules();
syncPayload();   // so an immediate Save with no edits round-trips the list unchanged
</script>
}
