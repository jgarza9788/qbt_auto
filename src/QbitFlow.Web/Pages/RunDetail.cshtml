@page
@model RunDetailModel
@{ ViewData["Title"] = "Run"; }

<section class="panel">
    <div class="spread">
        <div>
            <h1>@Model.PipelineName</h1>
            <span class="muted">
                <span class="pill @(Model.Run.Status switch { RunStatus.Succeeded => "ok", RunStatus.Running => "run", RunStatus.Failed => "err", _ => "" })">@Model.Run.Status.ToString().ToLower()</span>
                @(Model.Run.DryRun ? "dry-run · " : "") @Model.Run.Trigger · started @Model.Run.StartedUtc.ToLocalTime().ToString("MM-dd HH:mm:ss") · @(Model.Run.DurationMs) ms
            </span>
        </div>
        <div class="row">
            @if (Model.IsRunning)
            {
                <button class="danger" hx-post="/api/runs/@Model.Run.Id/cancel" hx-swap="none"
                        hx-on::after-request="setTimeout(() => location.reload(), 600)">Cancel run</button>
            }
            <a class="btn ghost" href="/Runs">All runs</a>
        </div>
    </div>
    <div class="row" style="margin-top:12px">
        <span class="muted">torrents <b>@Model.Run.TorrentsEvaluated</b></span>
        <span class="muted">rules <b>@Model.Run.RulesEvaluated</b></span>
        <span class="muted">applied <b>@Model.Run.ActionsApplied</b></span>
        <span class="muted">would apply <b>@Model.Run.ActionsWouldApply</b></span>
        <span class="muted">errors <b>@Model.Run.ErrorCount</b></span>
    </div>
</section>

@if (Model.RuleResults.Count > 0)
{
    <section>
        <h2>Per-rule</h2>
        <div class="panel scroll-x">
            <table>
                <tr><th>Rule</th><th>Match</th><th>No match</th><th>Error</th><th>Applied</th><th>Would apply</th></tr>
                @foreach (var rr in Model.RuleResults)
                {
                    <tr><td>@rr.RuleName</td><td>@rr.SuccessCount</td><td>@rr.FailureCount</td><td>@rr.ErrorCount</td><td>@rr.ActionsApplied</td><td>@rr.ActionsWouldApply</td></tr>
                }
            </table>
        </div>
    </section>
}

<section>
    <h2>Log @(Model.IsRunning ? "(live)" : "")</h2>
    <pre class="log" id="log">@foreach (var e in Model.Log)
{
        <text><span class="lvl-@e.Level">[@e.TimestampUtc.ToLocalTime().ToString("HH:mm:ss")] @e.Message</span>
</text>
}</pre>
</section>

@section Scripts {
@if (Model.IsRunning)
{
    <text>
    <script>
    (function () {
      const log = document.getElementById('log');
      const es = new EventSource('/api/runs/@Model.Run.Id/stream');
      es.addEventListener('log', ev => {
        const e = JSON.parse(ev.data);
        const line = document.createElement('span');
        line.className = 'lvl-' + e.Level;
        const ts = new Date(e.TimestampUtc).toLocaleTimeString();
        line.textContent = `[${ts}] ${e.Message}\n`;
        log.appendChild(line);
        log.scrollTop = log.scrollHeight;
      });
      es.addEventListener('done', () => { es.close(); setTimeout(() => location.reload(), 800); });
      es.onerror = () => es.close();
    })();
    </script>
    </text>
}
}
