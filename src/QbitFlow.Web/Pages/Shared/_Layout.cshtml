@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var tokens = Antiforgery.GetAndStoreTokens(ViewContext.HttpContext);
    string Active(string page) => string.Equals(ViewContext.RouteData.Values["page"]?.ToString(), page, StringComparison.OrdinalIgnoreCase) ? "active" : "";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@(ViewData["Title"] is string t ? $"{t} · qbit-flow" : "qbit-flow")</title>
    <meta name="csrf-header" content="@tokens.HeaderName">
    <meta name="csrf-token" content="@tokens.RequestToken">
    <link rel="stylesheet" href="~/app.css" asp-append-version="true">
    <script src="~/lib/htmx.min.js" defer></script>
    <script src="~/lib/htmx-ext-sse.js" defer></script>
    <script src="~/lib/sortable.min.js" defer></script>
</head>
<body hx-headers='@($"{{\"{tokens.HeaderName}\": \"{tokens.RequestToken}\"}}")'>
    <header>
        <a class="brand" href="/">qbit&#8209;flow</a>
        <nav>
            <a class="@Active("/Index")" href="/">Dashboard</a>
            <a class="@Active("/Rules")" href="/Rules">Rules</a>
            <a class="@Active("/Sources")" href="/Sources">Sources</a>
            <a class="@Active("/Runs")" href="/Runs">Runs</a>
            <a class="@Active("/Analytics")" href="/Analytics">Analytics</a>
            <a class="@Active("/Settings")" href="/Settings">Settings</a>
        </nav>
    </header>
    <main>
        @if (TempData["Msg"] is string msg)
        {
            <div class="toast">@msg</div>
        }
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
